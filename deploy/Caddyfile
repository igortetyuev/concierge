{
	auto_https disable_redirects
}

(app) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# Caddy internal-CA root, copied into the web root by deploy — install on
	# devices to trust https://__DOMAIN__
	@rootcert path /root.crt
	header @rootcert Content-Type application/x-x509-ca-cert
	header @rootcert Content-Disposition "attachment; filename=root.crt"

	# API + WebSocket: /api/* -> app root (e.g. /api/auth/login -> /auth/login)
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# PWA static build (deploy/deploy.sh rsyncs web/dist here), SPA fallback
	handle {
		root * /srv/concierge/app/web
		try_files {path} /index.html
		file_server
	}

	encode zstd gzip
}

__DOMAIN__ {
	tls internal
	import app
}

# LAN-only: plain HTTP too
:80 {
	import app
}
