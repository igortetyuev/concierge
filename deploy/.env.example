# Copy to deploy/.env (git-ignored) and fill in your values.

# SSH alias of the app server (from ~/.ssh/config)
CONCIERGE_REMOTE=my-server

# Site address served by Caddy (substituted into deploy/Caddyfile)
CONCIERGE_DOMAIN=concierge.local

# Install location on the server
CONCIERGE_DEST=/srv/concierge/app

# Local directory for pulled backups (backup-pull.sh)
CONCIERGE_BACKUP_DIR=$HOME/concierge-backups
