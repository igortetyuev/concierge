# Copy to server/.env (git-ignored). All settings use the CONCIERGE_ prefix;
# see src/concierge/core/config.py for the full list.

CONCIERGE_DATABASE_URL=postgresql+asyncpg://concierge@127.0.0.1:5432/concierge
CONCIERGE_QDRANT_URL=http://127.0.0.1:6333

# Fernet key encrypting secrets stored in the DB (telegram bot token, provider
# api keys). Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONCIERGE_SECRET_KEY=

# HMAC key signing access JWTs. MUST be set in production.
CONCIERGE_JWT_SECRET=

# Set true when serving over HTTPS only.
CONCIERGE_COOKIE_SECURE=false

CONCIERGE_BLOB_DIR=data/blobs
